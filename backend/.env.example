# ── Texture Browser — Backend Environment Variables ────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Database (Postgres on this machine) ───────────────────────────────────────
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://texture:CHANGE_ME@127.0.0.1:5432/texture_browser

# Shared secret the thumbnail Lambda sends to /internal routes.
INTERNAL_API_TOKEN=change-me

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
S3_BUCKET_NAME=texture-browser-assets

# S3 key prefixes (no leading slash)
S3_RAW_PREFIX=textures/raw
S3_THUMBS_PREFIX=textures/thumbs

# ── CORS ──────────────────────────────────────────────────────────────────────
# Add your EC2 public IP or domain here when deployed.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Gemini API ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

